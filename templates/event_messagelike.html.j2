<div class="sender-avatar avatar-container {{ self::get_avatar_color_class(event.sender.as_str()) }}" role="img" aria-label="Avatar for {{ event.sender.as_str() }}">
    {% if let Some(profile) = event.sender_profile %}
        {% if let Some(avatar_url) = profile.avatar_url %}
            <img class="avatar avatar-image"
                 src="/media/plain/thumbnail:100x100/{{ avatar_url.to_string() | urlencode_strict }}"
                 alt="{{ self::user_initials(event.sender.as_str(), profile.display_name.as_deref()) }}"
                 loading="lazy">
        {% else %}
        {{ self::user_initials(event.sender.as_str(), profile.display_name.as_deref()) }}
        {% endif %}
    {% else %}
        {{ self::user_initials(event.sender.as_str(), None) }}
    {% endif %}
</div>
<div class="sender-profile">
    {% if let Some(profile) = event.sender_profile %}
        <div class="sender-name">
            {% if let Some(display_name) = profile.display_name %} {{ display_name }}
            {% else %} {{ event.sender.as_str() }} {% endif %}
        </div>
    {% else %}
        <div class="sender-name no-profile">
            {{ event.sender.as_str() }}
        </div>
    {% endif %}
    <time class="profile-timestamp" datetime="{{ self::timestamp_to_string(event.timestamp) }}">{{ self::timestamp_to_format_string(event.timestamp) }}</time>
</div>
<div class="event-content message-like">
    {% match message_like_event.kind %}
        {% when MsgLikeKind::Message(message_content) %}
            {% match message_content.msgtype %}
                {% when MessageType::Text(text_content) %}
                    {% if let Some(formatted_body) = text_content.formatted.as_ref().and_then(self::html_body) %}
                        <div class="message-text formatted-body">
                            {{ formatted_body | safe }}
                            {% if message_content.edited %} <span class="edit-indicator">(edited)</span>{% endif %}
                        </div>
                    {% else %}
                        <div class="message-text plaintext-body">
                            {{ text_content.body }}
                            {% if message_content.edited %} <span class="edit-indicator">(edited)</span>{% endif %}
                        </div>
                    {% endif %}
                {% when MessageType::Notice(notice_content) %}
                    {% if let Some(formatted_body) = notice_content.formatted.as_ref().and_then(self::html_body) %}
                        <div class="message-notice formatted-body">
                            {{ formatted_body | safe }}
                            {% if message_content.edited %} <span class="edit-indicator">(edited)</span>{% endif %}
                        </div>
                    {% else %}
                        <div class="message-notice plaintext-body">
                            {{ notice_content.body }}
                            {% if message_content.edited %} <span class="edit-indicator">(edited)</span>{% endif %}
                        </div>
                    {% endif %}
                {% when MessageType::Emote(emote_content) %}
                    <div class="message-emote">
                        <span aria-hidden="true">*</span> {{ emote_content.body }}
                        {% if message_content.edited %} <span class="edit-indicator">(edited)</span>{% endif %}
                    </div>
                {% when MessageType::Image(image_content) %}
                    <figure class="message-image">
                        {% match image_content.source %}
                            {% when MediaSource::Plain(mxc_uri) %}
                                <img class="message-image-content"
                                     src="/media/plain/full/{{ mxc_uri.to_string() | urlencode_strict }}"
                                     alt="{{ image_content.body }}"
                                     loading="lazy">
                            {% when _ %}
                                <div class="media-error bg-error text-error" role="alert">
                                    <span aria-hidden="true">⚠️</span> Media source not supported
                                </div>
                        {% endmatch %}
                        {% if let Some(formatted_body) = image_content.formatted_caption().and_then(self::html_body) %}
                            <figcaption class="caption formatted-body">
                                {{ formatted_body | safe }}
                                {% if message_content.edited %} <span class="edit-indicator">(edited)</span>{% endif %}
                            </figcaption>
                        {% else if let Some(text_content) = image_content.caption() %}
                            <figcaption class="caption plaintext-body">
                                {{ text_content }}
                                {% if message_content.edited %} <span class="edit-indicator">(edited)</span>{% endif %}
                            </figcaption>
                        {% endif %}
                    </figure>
                {% when MessageType::Video(video_content) %}
                    <figure class="message-video">
                        {% match video_content.source %}
                            {% when MediaSource::Plain(mxc_uri) %}
                                <video class="message-video-content" controls aria-label="{{ video_content.body }}">
                                    <source src="/media/plain/full/{{ mxc_uri.to_string() | urlencode_strict }}">
                                    <p>Your browser does not support the video tag. <a href="/media/plain/full/{{ mxc_uri.to_string() | urlencode_strict }}">Download video</a></p>
                                </video>
                            {% when _ %}
                                <div class="media-error bg-error text-error" role="alert">
                                    <span aria-hidden="true">⚠️</span> Encrypted media source not supported
                                </div>
                        {% endmatch %}
                        {% if let Some(formatted_body) = video_content.formatted_caption().and_then(self::html_body) %}
                            <figcaption class="caption formatted-body">
                                {{ formatted_body | safe }}
                                {% if message_content.edited %} <span class="edit-indicator">(edited)</span>{% endif %}
                            </div>
                        {% else if let Some(text_content) = video_content.caption() %}
                            <div class="caption plaintext-body">
                                {{ text_content }}
                                {% if message_content.edited %} (edited) {% endif %}
                            </div>
                        {% endif %}
                    </figure>
                {% when MessageType::Audio(audio_content) %}
                    <div class="message-audio">
                        {% match audio_content.source %}
                            {% when MediaSource::Plain(mxc_uri) %}
                                <audio controls>
                                    <source src="/media/plain/full/{{ mxc_uri.to_string() | urlencode_strict }}">
                                    Your browser does not support the audio element.
                                </audio>
                            {% when _ %}
                                <div class="media-error">Encrypted media source not supported</div>
                        {% endmatch %}
                        {% if let Some(formatted_body) = audio_content.formatted_caption().and_then(self::html_body) %}
                            <div class="caption formatted-body">
                                {{ formatted_body | safe }}
                                {% if message_content.edited %} (edited) {% endif %}
                            </div>
                        {% else if let Some(text_content) = audio_content.caption() %}
                            <div class="caption plaintext-body">
                                {{ text_content }}
                                {% if message_content.edited %} (edited) {% endif %}
                            </div>
                        {% endif %}
                    </div>
                {% when MessageType::File(file_content) %}
                    <div class="message-file">
                        {% match file_content.source %}
                            {% when MediaSource::Plain(mxc_uri) %}
                                <a href="/media/plain/full/{{ mxc_uri.to_string() | urlencode_strict }}" download="{{ file_content.filename() }}" class="file-download">
                                    <div class="file-info">
                                        <div class="file-name">{{ file_content.filename() }}</div>
                                        {% if let Some(info) = file_content.info %}
                                            {% if let Some(size) = info.size %}
                                                <div class="file-size">({{ size }} bytes)</div>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </a>
                            {% when _ %}
                                <div class="file-info">{{ file_content.body }} (Encrypted media source not supported)</div>
                        {% endmatch %}
                        {% if let Some(formatted_body) = file_content.formatted_caption().and_then(self::html_body) %}
                            <div class="caption formatted-body">
                                {{ formatted_body | safe }}
                                {% if message_content.edited %} (edited) {% endif %}
                            </div>
                        {% else if let Some(text_content) = file_content.caption() %}
                            <div class="caption plaintext-body">
                                {{ text_content }}
                                {% if message_content.edited %} (edited) {% endif %}
                            </div>
                        {% endif %}
                    </div>
                {% when MessageType::Location(location_content) %}
                    <div class="message-location">
                        <div class="location-body">{{ location_content.body }}</div>
                        <div class="location-link">
                            <a href="{{ location_content.geo_uri }}" target="_blank">📍 View location</a>
                        </div>
                        {% if message_content.edited %} (edited) {% endif %}
                    </div>
                {% when MessageType::VerificationRequest(verification_content) %}
                    <div class="verification-icon">🔐</div>
                    {% if let Some(formatted_body) = verification_content.formatted.as_ref().and_then(self::html_body) %}
                        <div class="message-verification formatted-body">
                            {{ formatted_body | safe }}
                            {% if message_content.edited %} (edited) {% endif %}
                        </div>
                    {% else %}
                        <div class="message-verification plaintext-body">
                            {{ verification_content.body }}
                            {% if message_content.edited %} (edited) {% endif %}
                        </div>
                    {% endif %}
                {% when _ %}
                    {% if let Some(formatted_body) = self::message_formatted_body(&message_content.msgtype).and_then(self::html_body) %}
                        <div class="message-text formatted-body">
                            {{ formatted_body | safe }}
                            {% if message_content.edited %} (edited) {% endif %}
                        </div>
                    {% else %}
                        <div class="message-text plaintext-body">
                            {{ message_content.msgtype.body() }}
                            {% if message_content.edited %} (edited) {% endif %}
                        </div>
                    {% endif %}
            {% endmatch %}
        {% when MsgLikeKind::Sticker(sticker_content) %}
            <div class="message-sticker">
                {% match sticker_content.source %}
                    {% when StickerMediaSource::Plain(mxc_uri) %}
                        <img src="/media/plain/thumbnail:200x200/{{ mxc_uri.to_string() | urlencode_strict }}" alt="{{ sticker_content.body }}" title="{{ sticker_content.body }}" class="sticker-image" loading="lazy">
                    {% when _ %}
                        <div class="sticker-fallback>{{ sticker_content.body }}</div>
                        <div class="media-error">Sticker source not supported</div>
                {% endmatch %}
            </div>
        {% when MsgLikeKind::Reaction(emoji, event_id) %}
            <div class="message-reaction">
                <span class="reaction-text">reacted <span class="reaction-emoji">{{ emoji }}</span> to <a href="#event-{{ event_id }}">message</a></span>
            </div>
        {% when MsgLikeKind::CallInvite(call_id) %}
            <div class="message-call call-invite">
                <div class="call-icon">📞</div>
                <div class="call-info">
                    <div class="call-action">Started a call</div>
                    <div class="call-details">Call ID: {{ call_id }}</div>
                </div>
            </div>
        {% when MsgLikeKind::CallAnswer(call_id) %}
            <div class="message-call call-answer">
                <div class="call-icon">✅</div>
                <div class="call-info">
                    <div class="call-action">Answered the call</div>
                    <div class="call-details">Call ID: {{ call_id }}</div>
                </div>
            </div>
        {% when MsgLikeKind::CallHangup(call_id, reason) %}
            <div class="message-call call-hangup">
                <div class="call-icon">📴</div>
                <div class="call-info">
                    <div class="call-action">Ended the call</div>
                    <div class="call-details">Call ID: {{ call_id }}</div>
                    <div class="call-reason">Reason: {{ reason }}</div>
                </div>
            </div>
        {% when MsgLikeKind::CallReject(call_id) %}
            <div class="message-call call-reject">
                <div class="call-icon">❌</div>
                <div class="call-info">
                    <div class="call-action">Rejected the call</div>
                    <div class="call-details">Call ID: {{ call_id }}</div>
                </div>
            </div>
        {% when MsgLikeKind::CallNegotiate(call_id) %}
            <div class="message-call call-negotiate">
                <div class="call-icon">🔄</div>
                <div class="call-info">
                    <div class="call-action">Negotiating call</div>
                    <div class="call-details">Call ID: {{ call_id }}</div>
                </div>
            </div>
        {% when MsgLikeKind::CallCandidates(call_id) %}
            <div class="message-call call-candidates">
                <div class="call-icon">🔗</div>
                <div class="call-info">
                    <div class="call-action">Exchanging call connection details</div>
                    <div class="call-details">Call ID: {{ call_id }}</div>
                </div>
            </div>
        {% when MsgLikeKind::CallNotify(call_id) %}
            <div class="message-call call-notify">
                <div class="call-icon">🔔</div>
                <div class="call-info">
                    <div class="call-action">Call notification</div>
                    <div class="call-details">Call ID: {{ call_id }}</div>
                </div>
            </div>
        {% when MsgLikeKind::CallSelectAnswer(call_id) %}
            <div class="message-call call-select-answer">
                <div class="call-icon">✅</div>
                <div class="call-info">
                    <div class="call-action">Selected call answer</div>
                    <div class="call-details">Call ID: {{ call_id }}</div>
                </div>
            </div>
        {% when MsgLikeKind::CallMetadataChanged(call_id) %}
            <div class="message-call call-metadata-changed">
                <div class="call-icon">🔧</div>
                <div class="call-info">
                    <div class="call-action">Updated call metadata</div>
                    <div class="call-details">Call ID: {{ call_id }}</div>
                </div>
            </div>
        {% when MsgLikeKind::PollStart(question, answers) %}
            <div class="message-poll poll-start">
                <div class="poll-header">Started a poll</div>
                <div class="poll-question">{{ question }}</div>
                <div class="poll-answers">
                    {% for answer in answers %}
                        <div class="poll-answer" id="poll-{{ event.event_id }}-{{ answer.0 }}">
                            {{ answer.1 }}
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% when MsgLikeKind::PollResponse(answers, poll_event_id) %}
            <div class="message-poll poll-response">
                <div class="poll-info">
                    <div class="poll-action">Voted in poll</div>
                    <div class="poll-link">
                        <a href="#event-{{ poll_event_id }}">View poll</a>
                    </div>
                    <div class="poll-selections">
                        {% for answer in answers %}
                            <a href="#poll-{{ poll_event_id }}-{{ answer }}" class="poll-selection">{{ answer }}</a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% when MsgLikeKind::PollEnd(result) %}
            <div class="message-poll poll-end">
                <div class="poll-info">
                    <div class="poll-action">Poll ended</div>
                    <div class="poll-result">{{ result }}</div>
                </div>
            </div>
        {% when MsgLikeKind::KeyVerificationReady(from_device) %}
            <div class="message-verification verification-ready">
                <div class="verification-icon">🔐</div>
                <div class="verification-info">
                    <div class="verification-action">Ready for key verification</div>
                    <div class="verification-device">From device: {{ from_device }}</div>
                </div>
            </div>
        {% when MsgLikeKind::KeyVerificationStart(from_device) %}
            <div class="message-verification verification-start">
                <div class="verification-icon">🔓</div>
                <div class="verification-info">
                    <div class="verification-action">Started key verification</div>
                    <div class="verification-device">From device: {{ from_device }}</div>
                </div>
            </div>
        {% when MsgLikeKind::KeyVerificationCancel(reason, code) %}
            <div class="message-verification verification-cancel">
                <div class="verification-icon">❌</div>
                <div class="verification-info">
                    <div class="verification-action">Cancelled key verification</div>
                    <div class="verification-reason">{{ reason }}</div>
                    <div class="verification-code">Code: {{ code }}</div>
                </div>
            </div>
        {% when MsgLikeKind::KeyVerificationAccept %}
            <div class="message-verification verification-accept">
                <div class="verification-icon">✅</div>
                <div class="verification-info">
                    <div class="verification-action">Accepted key verification</div>
                </div>
            </div>
        {% when MsgLikeKind::KeyVerificationKey %}
            <div class="message-verification verification-key">
                <div class="verification-icon">🔑</div>
                <div class="verification-info">
                    <div class="verification-action">Exchanged verification key</div>
                </div>
            </div>
        {% when MsgLikeKind::KeyVerificationMac %}
            <div class="message-verification verification-mac">
                <div class="verification-icon">🔒</div>
                <div class="verification-info">
                    <div class="verification-action">Sent verification MAC</div>
                </div>
            </div>
        {% when MsgLikeKind::KeyVerificationDone %}
            <div class="message-verification verification-done">
                <div class="verification-icon">🎉</div>
                <div class="verification-info">
                    <div class="verification-action">Key verification completed successfully</div>
                </div>
            </div>
        {% when MsgLikeKind::Redacted %}
            <div class="redaction-text plaintext-body">
                Message was redacted.
            </div>
        {% when MsgLikeKind::UnableToDecrypt %}
            <div class="unable-to-decrypt">
                Unable to decrypt this message.
            </div>
        {% when MsgLikeKind::Hidden %}
            <div class="hidden-message">
            </div>
        {% when MsgLikeKind::UnsupportedType %}
            <div class="unsupported-type">
                Unsupported message type
            </div>
    {% endmatch %}
    {% if let Some(in_reply_to_details) = message_like_event.in_reply_to %}
        <div class="in-reply-to">
            Replying to <a href="#event-{{ in_reply_to_details.event_id }}">{{ in_reply_to_details.event_id }}</a>
        </div>
    {% endif %}

    <time class="timestamp-trailing" datetime="{{ self::timestamp_to_string(event.timestamp) }}">{{ self::timestamp_to_format_string(event.timestamp) }}</time>
</div>

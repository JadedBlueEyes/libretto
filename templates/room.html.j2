<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Room - {{ name }}</title>
    <style>
        /*<![CDATA[*/
            {{ String::from_utf8_lossy(crate::assets::Dist::get("room.css").unwrap().data) | safe}}
        /*]]>*/
    </style>
</head>
<body>
    <main class="room">
        <div class="room-header">
            <h1>{{ name }}</h1>
            <p>Room ID: {{ room_id | safe }}</p>
            {% if let Some(prev_page) = prev_page %}
            <p><a href={{prev_page}}>Prev page</a></p>
            {% endif %}
            {% if let Some(next_page) = next_page %}
            <p><a href={{next_page}}>Next page</a></p>
            {% endif %}
        </div>
        <div class="timeline">
        <div class="timeline-list">
            {% for event in events %}
                {% include "event.html.j2" %}
            {% endfor %}
            </div>
        </div>
    </main>
</body>
</html>

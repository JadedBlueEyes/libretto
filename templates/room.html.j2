<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Room - {{ name }}</title>
    <style>
        /*<![CDATA[*/
            {{ String::from_utf8_lossy(crate::assets::Dist::get("room.css").expect("Failed to get style").data) | safe}}
        /*]]>*/
    </style>
    {{ crate::assets::DistVite::get_html_tags_for_asset::<crate::assets::Dist>("js/room.js") | safe }}
</head>
<body>
    <main class="room">
        <header class="room-header">
            <div class="room-header-content">
                <h1 class="room-title">{{ name }}</h1>
                <p class="room-id">Room ID: <code>{{ room_id | safe }}</code></p>

                {% if prev_page.is_some() || next_page.is_some() %}
                <nav class="room-navigation">
                    {% if let Some(prev_page) = prev_page %}
                    <a href="{{ prev_page }}" class="nav-button" rel="prev">
                        <span aria-hidden="true">←</span> Previous page
                    </a>
                    {% endif %}
                    {% if let Some(next_page) = next_page %}
                    <a href="{{ next_page }}" class="nav-button" rel="next">
                        Next page <span aria-hidden="true">→</span>
                    </a>
                    {% endif %}
                </nav>
                {% endif %}
            </div>
        </header>

        <section class="timeline" aria-label="Message timeline">
            <div class="timeline-list">
            {% for event in events %}
                {% include "event.html.j2" %}
            {% endfor %}
            </div>
        </section>
    </main>
</body>
</html>
